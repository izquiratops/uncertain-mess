# Use test resources without secrets or private content. Do not commit .env.
LINEAR_API_KEY=
LINEAR_ISSUE_ID=
# Expected values from the test issue, used to verify normalization.
LINEAR_EXPECTED_CRITERION=
LINEAR_EXPECTED_ATTACHMENT_URL=
# Optional: a separate issue with more than 100 attachments.
LINEAR_PAGINATION_ISSUE_ID=
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_URL=
FIGMA_NODE_URL=
# The integrated test requires FIGMA_NODE_URL as a required-context directive
# in LINEAR_ISSUE_ID. Other required references must also be resolvable.
